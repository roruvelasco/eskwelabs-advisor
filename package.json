{
  "name": "eskwelabs-advisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env run turbo dev",
    "dev:web": "bun --env-file=.env run turbo dev --filter=@eskwelabs-advisor/web",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --check --ignore-unknown .",
    "format:fix": "prettier --write --ignore-unknown .",
    "test": "turbo test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "node -e \"console.log('Supabase Studio: http://127.0.0.1:54323')\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "supabase": "^2.104.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write --ignore-unknown",
      "bun x eslint --fix --max-warnings=0"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "drizzle-zod": "^0.8.3",
    "zod": "^4.0.0"
  }
}
