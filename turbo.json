{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "lint:staged": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "GOOGLE_DOCS_SERVICE_ACCOUNT_JSON",
    "OPENAI_API_KEY",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "ANTHROPIC_API_KEY",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "GROQ_API_KEY",
    "GROQ_BASE_URL",
    "PROVIDER_TIMEOUT_MS",
    "GOOGLE_DOCS_DNA_DOC_ID",
    "DAILY_MESSAGE_LIMIT",
    "DAILY_TOKEN_LIMIT",
    "DAILY_SPEND_LIMIT_USD",
    "DEFAULT_MAX_OUTPUT_TOKENS",
    "RATE_LIMIT_WINDOW_SECONDS",
    "RATE_LIMIT_MAX_REQUESTS",
    "AUTH_SECRET",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "APP_ORIGIN",
    "NEXTAUTH_URL",
    "NEXTAUTH_SECRET",
    "NODE_ENV",
    "RUNTIME_PROFILE",
    "LLM_PROVIDER_MODE",
    "PROMPT_PROVIDER_MODE",
    "TITLE_GENERATION_PROVIDER",
    "TITLE_GENERATION_MODEL",
    "CRON_SECRET"
  ]
}
